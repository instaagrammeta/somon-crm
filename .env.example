# ===========================
# Somon CRM — Environment
# ===========================
# 1) Copy this file:   cp .env.example .env
# 2) Edit values below
# 3) docker compose up -d --build

# --- Public access ---
# HTTP port exposed by nginx (80 = standard)
PUBLIC_PORT=80

# Application environment
APP_ENV=production
DEFAULT_LOCALE=tg

# --- Database ---
DB_USER=somon
DB_PASSWORD=CHANGE_ME_strong_password_here
DB_NAME=somon_crm
DB_SSLMODE=disable

# --- Auth (CRITICAL — change!) ---
# Use openssl rand -hex 32  to generate a fresh value
JWT_SECRET=CHANGE_ME_use_openssl_rand_hex_32_to_generate
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_HOURS=168

# --- Initial admin user (created on first run) ---
ADMIN_LOGIN=admin
ADMIN_PASSWORD=CHANGE_ME_admin_password
ADMIN_FULL_NAME=Главный Администратор

# Set to "true" if you change ADMIN_PASSWORD AFTER the first start.
# It will reset the password on next 'docker compose up'. Set back to false later.
RESET_ADMIN_PASSWORD=false

# --- Telegram bot ---
# Get a token from @BotFather, then put it here.
# Leave empty to disable Telegram notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=somon_crm_bot
TELEGRAM_NOTIFICATIONS_ENABLED=true

# --- Uploads ---
UPLOAD_MAX_MB=50

# --- CORS (leave * if you front it with our nginx) ---
CORS_ALLOWED_ORIGINS=*



# ===========================
# v-2 additions
# ===========================

# --- AI (DeepSeek by default — fully OpenAI-compatible) ---
# Get a key at https://platform.deepseek.com — leave empty to disable AI features.
AI_PROVIDER=deepseek
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_CHAT_MODEL=deepseek-chat
AI_REASONING_MODEL=deepseek-reasoner
AI_VISION_MODEL=deepseek-vl2
AI_HTTP_TIMEOUT_SECONDS=60
AI_MAX_PER_MINUTE=30

# Whisper-style transcription. Optional override; falls back to AI_BASE_URL/KEY.
# Groq's Whisper is much faster: AI_WHISPER_BASE_URL=https://api.groq.com/openai/v1
AI_WHISPER_MODEL=whisper-1
AI_WHISPER_BASE_URL=
AI_WHISPER_API_KEY=

# --- WhatsApp Business Cloud API (Meta) ---
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=somon-verify
WHATSAPP_BASE_URL=https://graph.facebook.com/v20.0

# --- Email (IMAP for inbound, SMTP for outbound) ---
EMAIL_ENABLED=false
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_TLS=true

# --- Public website branding ---
SITE_BRAND_NAME=Somon Real Estate
SITE_PHONE=+992 901 23 45 67
SITE_EMAIL=info@somon.tj
SITE_ADDRESS=Душанбе, Тоҷикистон
SITE_APK_URL=/static/apk/somon-crm.apk
SITE_APK_VERSION=2.0.0
