# ===========================
# Somon CRM — Environment
# ===========================
# 1) Copy this file:   cp .env.example .env
# 2) Edit values below
# 3) docker compose up -d --build

# --- Public access ---
# HTTP port exposed by nginx (80 = standard)
PUBLIC_PORT=80

# Application environment
APP_ENV=production
DEFAULT_LOCALE=tg

# --- Database ---
DB_USER=somon
DB_PASSWORD=CHANGE_ME_strong_password_here
DB_NAME=somon_crm
DB_SSLMODE=disable

# --- Auth (CRITICAL — change!) ---
# Use openssl rand -hex 32  to generate a fresh value
JWT_SECRET=CHANGE_ME_use_openssl_rand_hex_32_to_generate
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_HOURS=168

# --- Initial admin user (created on first run) ---
ADMIN_LOGIN=admin
ADMIN_PASSWORD=CHANGE_ME_admin_password
ADMIN_FULL_NAME=Главный Администратор

# Set to "true" if you change ADMIN_PASSWORD AFTER the first start.
# It will reset the password on next 'docker compose up'. Set back to false later.
RESET_ADMIN_PASSWORD=false

# --- Telegram bot ---
# Get a token from @BotFather, then put it here.
# Leave empty to disable Telegram notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=somon_crm_bot
TELEGRAM_NOTIFICATIONS_ENABLED=true

# --- Uploads ---
UPLOAD_MAX_MB=50

# --- CORS (leave * if you front it with our nginx) ---
CORS_ALLOWED_ORIGINS=*
