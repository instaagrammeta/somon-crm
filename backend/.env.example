# Server
APP_ENV=development
APP_PORT=8080
APP_HOST=0.0.0.0
APP_BASE_URL=http://localhost:8080

# Database (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_USER=somon
DB_PASSWORD=somon_secret_change_me
DB_NAME=somon_crm
DB_SSLMODE=disable

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_HOURS=168

# Admin seed (created on first run)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=nav-xona@2026
ADMIN_FULL_NAME=Главный Администратор

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=somon_crm_bot
TELEGRAM_NOTIFICATIONS_ENABLED=true

# Uploads
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=50

# CORS (comma separated origins, * for any)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Default locale (tg or ru)
DEFAULT_LOCALE=tg
